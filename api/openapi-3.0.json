          "result_id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "result_id"
        ],
        "type": "object"
      },
      "TodoRequest": {
        "properties": {
          "command": {
            "$ref": "#/components/schemas/TodoCommand"
          },
          "operation_id": {
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "command"
        ],
        "type": "object"
      },
      "TodoSnapshot": {
        "properties": {
