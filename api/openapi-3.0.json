            "items": {
              "$ref": "#/components/schemas/Todo"
            },
            "type": "array"
          }
        },
        "required": [
          "todos"
        ],
        "type": "object"
      },
      "Version": {
        "properties": {
          "api": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "product": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "product",
          "version",
          "api"
        ],
        "type": "object"
      },
      "Workspace": {
        "properties": {
          "color": {
            "nullable": true,
            "type": "string"
          },
          "icon": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "WorkspaceCommand": {
        "oneOf": [
          {
            "properties": {
              "color": {
                "nullable": true,
                "type": "string"
              },
              "icon": {
                "nullable": true,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "create"
                ],
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "rename"
                ],
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "switch"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "WorkspaceReceipt": {
        "properties": {
          "result_id": {
            "type": "string"
          }
        },
        "required": [
          "result_id"
        ],
        "type": "object"
      },
      "WorkspaceRequest": {
        "properties": {
          "command": {
            "$ref": "#/components/schemas/WorkspaceCommand"
          },
          "operation_id": {
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "command"
        ],
        "type": "object"
      },
      "WorkspaceSnapshot": {
        "properties": {
          "current_id": {
            "type": "string"
          },
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/Workspace"
            },
            "type": "array"
          }
        },
        "required": [
          "current_id",
          "workspaces"
        ],
        "type": "object"
      }
    }
  },
