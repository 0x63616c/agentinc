{
  "components": {
    "schemas": {
      "Acknowledgement": {
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "result_id": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "operation_id"
        ],
        "type": "object"
      },
      "Command": {
        "oneOf": [
          {
            "properties": {
              "kind": {
                "enum": [
                  "create_conversation"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "rename_conversation"
                ],
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "delete_conversation"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "select_conversation"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "conversation_id": {
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "send"
                ],
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            },
            "required": [
              "conversation_id",
              "prompt",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "retry"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "create_todo"
                ],
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "completed": {
                "type": "boolean"
              },
              "id": {
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "complete_todo"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "completed",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "delete_todo"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "select_model"
                ],
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            },
            "required": [
              "model",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "CommandRequest": {
        "properties": {
          "command": {
            "$ref": "#/components/schemas/Command"
          },
          "operation_id": {
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "command"
        ],
        "type": "object"
      },
      "ConnectionStatus": {
        "properties": {
          "account": {
            "nullable": true,
            "type": "string"
          },
          "auth_url": {
            "nullable": true,
            "type": "string"
          },
          "error": {
            "nullable": true,
            "type": "string"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/Model"
            },
            "type": "array"
          },
          "signing_in": {
            "type": "boolean"
          }
        },
        "required": [
          "models",
          "signing_in"
        ],
        "type": "object"
      },
      "Conversation": {
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "snippet": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updated": {
            "type": "string"
          },
          "updated_at": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "title",
          "snippet",
          "updated",
          "updated_at"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Model": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "Settings": {
        "properties": {
          "model": {
            "nullable": true,
            "type": "string"
          },
          "selected_conversation": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Snapshot": {
        "properties": {
          "conversations": {
            "items": {
              "$ref": "#/components/schemas/Conversation"
            },
            "type": "array"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "todos": {
            "items": {
              "$ref": "#/components/schemas/Todo"
            },
            "type": "array"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "type": "array"
          }
        },
        "required": [
          "conversations",
          "turns",
          "todos",
          "settings"
        ],
        "type": "object"
      },
      "TicketContract": {
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "Todo": {
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "completed"
        ],
        "type": "object"
      },
      "Turn": {
        "properties": {
          "conversation_id": {
            "format": "int64",
            "type": "integer"
          },
          "error": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "response": {
            "nullable": true,
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "prompt",
          "state"
        ],
        "type": "object"
      },
      "Version": {
        "properties": {
          "api": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "product": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "product",
          "version",
          "api"
        ],
        "type": "object"
      }
    }
  },
  "info": {
