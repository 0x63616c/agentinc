{
  "components": {
    "responses": {
      "Internal": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "The daemon failed; see its log."
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "Owner credential required."
      },
      "UpgradeRequired": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "Update to continue."
      }
    },
    "schemas": {
      "CalendarCommand": {
        "oneOf": [
          {
            "properties": {
              "ends_at": {
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "create"
                ],
                "type": "string"
              },
              "starts_at": {
                "format": "int64",
                "type": "integer"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "starts_at",
              "ends_at",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "delete"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "CalendarEvent": {
        "description": "Times are epoch seconds.",
        "properties": {
          "ends_at": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "starts_at": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "starts_at",
          "ends_at"
        ],
        "type": "object"
      },
      "CalendarReceipt": {
        "description": "The id of the Event the command touched.",
        "properties": {
          "result_id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "result_id"
        ],
        "type": "object"
      },
      "CalendarRequest": {
        "properties": {
          "command": {
            "$ref": "#/components/schemas/CalendarCommand"
          },
          "operation_id": {
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "command"
        ],
        "type": "object"
      },
      "CalendarSnapshot": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/CalendarEvent"
            },
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "The one shape every non-2xx response has.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "The closed set of error codes a client can switch on.",
        "enum": [
          "invalid",
          "conflict",
          "unauthorized",
          "forbidden",
          "not_found",
          "unavailable",
          "internal",
          "upgrade_required"
        ],
        "type": "string"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Todo": {
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "completed"
        ],
        "type": "object"
      },
