+/// Minimal opt-in, process-local automation seam. No transport lives in GPUI.
+#[cfg(feature = "pilot")]
+impl Window {
+    /// Activate typed semantics locally without activating an OS screen reader.
+    pub fn pilot_enable(&mut self) {
+        self.a11y.pilot_active = true;
+        self.refresh();
+    }
+
+    /// Last complete semantics and corresponding committed scene generation.
+    pub fn pilot_frame(&self) -> Option<(u64, &accesskit::TreeUpdate)> {
+        self.a11y
+            .pilot_tree
+            .as_ref()
+            .map(|tree| (self.a11y.pilot_frame, tree))
+    }
+
+    /// Whether application changes require a new committed frame.
+    pub fn pilot_needs_draw(&self) -> bool {
+        self.invalidator.is_dirty() || self.a11y.pilot_frame == 0
+    }
+
+    /// Test a semantic element's actual clipped hitbox against the rendered frame.
+    pub fn pilot_hit_test(&self, node: accesskit::NodeId, point: Point<Pixels>) -> bool {
+        self.a11y
+            .pilot_hitboxes
+            .get(&node)
+            .is_some_and(|hitbox| hitbox.is_hovered_at(point, self))
+    }
+
+    /// Clipped logical bounds of a semantic element's input target.
+    pub fn pilot_hit_bounds(&self, node: accesskit::NodeId) -> Option<Bounds<Pixels>> {
+        self.a11y
+            .pilot_hitboxes
+            .get(&node)
+            .map(|hitbox| hitbox.bounds.intersect(&hitbox.content_mask.bounds))
+    }
+
+    /// Commit Unicode text through the platform input handler, preserving selection/undo.
+    pub fn pilot_type_text(&mut self, text: &str, cx: &mut App) -> bool {
+        if let Some(mut handler) = self.platform_window.take_input_handler() {
+            let accepts = handler.accepts_text_input(self, cx);
+            if accepts {
+                handler.dispatch_input(text, self, cx);
+            }
+            self.platform_window.set_input_handler(handler);
+            accepts
+        } else {
+            false
+        }
+    }
+}
